# Istio Gateway, VirtualServices, and DestinationRules for WSO2 API Manager Pattern 3.
#
# The ingress gateway accepts plain HTTP on port 80. VirtualServices inject the
# x-forwarded-proto: https header so APIM sees HTTPS requests. DestinationRules
# configure TLS (SIMPLE + insecureSkipVerify) toward the APIM pods, which serve
# HTTPS on their actual service ports.
#
# ISTIO_GATEWAY_NAME: name of the Gateway resource (default: apim-istio-gateway)

---
apiVersion: networking.istio.io/v1
kind: Gateway
metadata:
  name: ${ISTIO_GATEWAY_NAME}
  namespace: ${NAMESPACE}
spec:
  selector:
    istio: ingressgateway
  servers:
    - port:
        name: http-apim
        number: 80
        protocol: HTTP
      hosts:
        - "${CONTROL_PLANE_HOSTNAME}"
        - "${GW_HOSTNAME}"
        - "${WS_HOSTNAME}"
        - "${WEBSUB_HOSTNAME}"

---
# VirtualService: Control Plane (ACP)
# Handles APIM publisher, developer portal, and admin UI at port 9443.
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  name: apim-control-plane-vs
  namespace: ${NAMESPACE}
spec:
  gateways:
    - ${NAMESPACE}/${ISTIO_GATEWAY_NAME}
  hosts:
    - "${CONTROL_PLANE_HOSTNAME}"
  http:
    - name: control-plane
      headers:
        request:
          set:
            x-forwarded-proto: https
      route:
        - destination:
            host: openg2p-wso2-apim-control-plane-service
            port:
              number: 9443

---
# DestinationRule: Control Plane — upstream speaks HTTPS.
# exportTo restricts this rule to the istio-system namespace (ingress gateway only).
# In-cluster pod-to-pod traffic uses Istio auto-mTLS (no SIMPLE TLS origination),
# which avoids double-TLS since WSO2 already wraps its connections in TLS.
apiVersion: networking.istio.io/v1
kind: DestinationRule
metadata:
  name: apim-control-plane-dr
  namespace: ${NAMESPACE}
spec:
  exportTo:
    - "istio-system"
  host: openg2p-wso2-apim-control-plane-service
  trafficPolicy:
    tls:
      mode: SIMPLE
      insecureSkipVerify: true

---
# VirtualService: API Gateway
# Routes HTTP→HTTPS API traffic (port 8243) for published APIs.
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  name: apim-gateway-vs
  namespace: ${NAMESPACE}
spec:
  gateways:
    - ${NAMESPACE}/${ISTIO_GATEWAY_NAME}
  hosts:
    - "${GW_HOSTNAME}"
  http:
    - name: gateway
      headers:
        request:
          set:
            x-forwarded-proto: https
      route:
        - destination:
            host: openg2p-wso2-apim-gateway-service
            port:
              number: 8243

---
# DestinationRule: API Gateway — upstream speaks HTTPS.
# exportTo restricts this rule to the istio-system namespace (ingress gateway only).
# In-cluster pod-to-pod traffic uses Istio auto-mTLS (no SIMPLE TLS origination),
# which avoids double-TLS since WSO2 already wraps its connections in TLS.
apiVersion: networking.istio.io/v1
kind: DestinationRule
metadata:
  name: apim-gateway-dr
  namespace: ${NAMESPACE}
spec:
  exportTo:
    - "istio-system"
  host: openg2p-wso2-apim-gateway-service
  trafficPolicy:
    tls:
      mode: SIMPLE
      insecureSkipVerify: true

---
# VirtualService: WebSocket Gateway
# Routes traffic (port 9099) for streaming APIs. timeout=0s disables request timeout.
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  name: apim-websocket-vs
  namespace: ${NAMESPACE}
spec:
  gateways:
    - ${NAMESPACE}/${ISTIO_GATEWAY_NAME}
  hosts:
    - "${WS_HOSTNAME}"
  http:
    - name: websocket
      headers:
        request:
          set:
            x-forwarded-proto: https
      route:
        - destination:
            host: openg2p-wso2-apim-gateway-service
            port:
              number: 9099

---
# VirtualService: WebSub Gateway
# Routes traffic (port 8021) for WebSub/webhook delivery.
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  name: apim-websub-vs
  namespace: ${NAMESPACE}
spec:
  gateways:
    - ${NAMESPACE}/${ISTIO_GATEWAY_NAME}
  hosts:
    - "${WEBSUB_HOSTNAME}"
  http:
    - name: websub
      headers:
        request:
          set:
            x-forwarded-proto: https
      route:
        - destination:
            host: openg2p-wso2-apim-gateway-service
            port:
              number: 8021
