# Kubernetes and namespace
KUBECONFIG=/home/chamath/Downloads/openg2p-dad.yaml
NAMESPACE=wso2-apim
INGRESS_CLASS=nginx
TLS_SECRET_NAME=

# WSO2 Pattern 3 chart and release names
WSO2_CHART_VERSION=4.6.0-1
ACP_RELEASE_NAME=apim-acp
TM_RELEASE_NAME=apim-tm
GW_RELEASE_NAME=apim-gw

# Public hostnames
CONTROL_PLANE_HOSTNAME=am.example.local
GW_HOSTNAME=gw.example.local
WS_HOSTNAME=websocket.example.local
WEBSUB_HOSTNAME=websub.example.local

# Istio VirtualService settings
# ISTIO_TLS_MODE: PASSTHROUGH (upstream APIM terminates TLS) or SIMPLE (edge termination)
# ISTIO_TLS_CREDENTIAL: credentialName of the TLS secret in istio-system (used only when mode=SIMPLE)
ISTIO_GATEWAY_NAME=apim-istio-gateway
ISTIO_TLS_MODE=PASSTHROUGH
ISTIO_TLS_CREDENTIAL=

# PostgreSQL connection details
DB_HOST=172.30.151.50
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
APIM_DB_NAME=apim_db
SHARED_DB_NAME=shared_db
DB_SECRET_NAME=wso2-apim-db
POSTGRES_JDBC_VERSION=42.7.4
POSTGRES_JDBC_URL=https://jdbc.postgresql.org/download/postgresql-${POSTGRES_JDBC_VERSION}.jar

# Database preparation settings
DB_PREPARE_MODE=cluster
DB_PREPARE_IMAGE=postgres:16-alpine
DB_PREPARE_TIMEOUT=300s
DB_PREPARE_CLEANUP_POD=true

# Schema bootstrap settings
SCHEMA_APPLY_MODE=cluster
SCHEMA_SOURCE_IMAGE=
SCHEMA_CHECK_SHARED_TABLE=idn_base_table
SCHEMA_CHECK_APIM_TABLE=am_api

# APIM super admin
APIM_ADMIN_USERNAME=admin
APIM_ADMIN_PASSWORD=admin

# Keystore/truststore secret
KEYSTORE_SECRET_NAME=apim-keystore-secret
AUTO_GENERATE_KEYSTORES=true
KEYSTORE_PASSWORD=wso2carbon
KEYSTORE_KEY_PASSWORD=wso2carbon
KEYSTORE_DNAME=CN=am.example.local,OU=Platform,O=OpenG2P,L=Colombo,ST=Western,C=LK

# WSO2 subscription registry
IMAGE_REGISTRY=docker.wso2.com
ACP_IMAGE_REPOSITORY=wso2am-acp
TM_IMAGE_REPOSITORY=wso2am-tm
GW_IMAGE_REPOSITORY=wso2am-universal-gw
IMAGE_PULL_SECRET_USERNAME=REPLACE_WITH_WSO2_USERNAME
IMAGE_PULL_SECRET_PASSWORD=REPLACE_WITH_WSO2_PASSWORD
ACP_IMAGE_TAG=4.6.0
TM_IMAGE_TAG=4.6.0
GW_IMAGE_TAG=4.6.0

# Custom registry where built images are pushed and pods pull from
CUSTOM_IMAGE_REGISTRY=docker.io
ACP_CUSTOM_IMAGE_REPOSITORY=vsoneworld/openg2pdad-wso2-apim-acp
TM_CUSTOM_IMAGE_REPOSITORY=vsoneworld/openg2pdad-wso2-apim-tm
GW_CUSTOM_IMAGE_REPOSITORY=vsoneworld/openg2pdad-wso2-apim-universal-gw
CUSTOM_IMAGE_PULL_SECRET_USERNAME=REPLACE_WITH_REGISTRY_USERNAME
CUSTOM_IMAGE_PULL_SECRET_PASSWORD=REPLACE_WITH_REGISTRY_PASSWORD
IMAGE_PULL_SECRET_NAME=apim-image-registry-auth
SKIP_IMAGE_BUILD=false

# Replica settings
ACP_REPLICAS=1
TM_REPLICAS=1
GW_REPLICAS=1
GW_MIN_REPLICAS=1
GW_MAX_REPLICAS=2
GW_CPU_REQUEST=500m
GW_MEMORY_REQUEST=1Gi
GW_CPU_LIMIT=1500m
GW_MEMORY_LIMIT=2Gi
GW_JVM_XMS=1024m
GW_JVM_XMX=1024m

# Helm behavior
HELM_TIMEOUT=20m
HELM_WAIT=true
HELM_ATOMIC=true
