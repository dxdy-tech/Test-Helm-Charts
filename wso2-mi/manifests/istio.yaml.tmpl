# Istio Gateway and VirtualService for WSO2 Integrator: MI.
#
# TLS mode: PASSTHROUGH — MI pods terminate TLS using their own JKS keystores,
# so the ingress gateway forwards raw TLS and does not terminate or re-encrypt.
# If a shared edge TLS cert is preferred, change mode to SIMPLE and set credentialName.
#
# ISTIO_GATEWAY_NAME  : name of the Gateway resource (default: mi-istio-gateway)
# ISTIO_TLS_MODE      : PASSTHROUGH | SIMPLE (default: PASSTHROUGH)
# ISTIO_TLS_CREDENTIAL: credentialName for the TLS cert when mode=SIMPLE (ignored for PASSTHROUGH)
# MI_HTTPS_PORT       : MI pass-through HTTPS port (8243 + portOffset - 10; default 8253 with portOffset=10)

---
apiVersion: networking.istio.io/v1beta1
kind: Gateway
metadata:
  name: ${ISTIO_GATEWAY_NAME}
  namespace: ${NAMESPACE}
spec:
  selector:
    istio: ingressgateway
  servers:
    - port:
        number: 443
        name: https-mi
        protocol: HTTPS
      hosts:
        - "${MI_HOSTNAME}"
      tls:
        mode: ${ISTIO_TLS_MODE}
        credentialName: "${ISTIO_TLS_CREDENTIAL}"

---
# VirtualService: MI pass-through HTTPS
# Routes HTTPS API/management traffic (MI_HTTPS_PORT) for deployed integrations.
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: mi-vs
  namespace: ${NAMESPACE}
spec:
  gateways:
    - ${NAMESPACE}/${ISTIO_GATEWAY_NAME}
  hosts:
    - "${MI_HOSTNAME}"
  tls:
    - match:
        - port: 443
          sniHosts:
            - "${MI_HOSTNAME}"
      route:
        - destination:
            host: ${CLOUD_NAME}-${MI_RELEASE_NAME}
            port:
              number: ${MI_HTTPS_PORT}

---
# Gateway: ICP (Integration Control Plane) dashboard HTTPS ingress.
# ICP terminates TLS using its own JKS keystore (PASSTHROUGH mode).
apiVersion: networking.istio.io/v1beta1
kind: Gateway
metadata:
  name: ${ICP_ISTIO_GATEWAY_NAME}
  namespace: ${NAMESPACE}
spec:
  selector:
    istio: ingressgateway
  servers:
    - port:
        number: 443
        name: https-icp
        protocol: HTTPS
      hosts:
        - "${ICP_HOSTNAME}"
      tls:
        mode: ${ISTIO_TLS_MODE}
        credentialName: "${ISTIO_TLS_CREDENTIAL}"

---
# VirtualService: ICP dashboard HTTPS on port 9743.
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: icp-vs
  namespace: ${NAMESPACE}
spec:
  gateways:
    - ${NAMESPACE}/${ICP_ISTIO_GATEWAY_NAME}
  hosts:
    - "${ICP_HOSTNAME}"
  tls:
    - match:
        - port: 443
          sniHosts:
            - "${ICP_HOSTNAME}"
      route:
        - destination:
            host: ${CLOUD_NAME}-${ICP_RELEASE_NAME}
            port:
              number: ${ICP_HTTPS_PORT}
