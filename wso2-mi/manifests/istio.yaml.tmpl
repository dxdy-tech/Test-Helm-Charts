# Istio Gateway, VirtualServices, and DestinationRules for WSO2 MI + ICP.
#
# One shared Gateway accepts plain HTTP on port 80 for both hostnames.
# VirtualServices inject x-forwarded-proto: https so MI/ICP see HTTPS requests.
# DestinationRules tell Envoy to originate SIMPLE TLS toward each backend pod
# (which listens on HTTPS with its JKS keystore). insecureSkipVerify skips
# hostname validation against the self-signed certificate.
#
# ISTIO_GATEWAY_NAME: name of the shared Gateway resource (default: mi-istio-gateway)
# MI_HTTPS_PORT     : MI HTTPS port exposed by the K8s service (8243 + portOffset - 10)
# ICP_HTTPS_PORT    : ICP dashboard HTTPS port (default: 9743)

---
# Shared Gateway for MI and ICP — accepts HTTP from the ingress controller.
apiVersion: networking.istio.io/v1
kind: Gateway
metadata:
  name: ${ISTIO_GATEWAY_NAME}
  namespace: ${NAMESPACE}
spec:
  selector:
    istio: ingressgateway
  servers:
    - port:
        number: 80
        name: http-mi
        protocol: HTTP
      hosts:
        - "${MI_HOSTNAME}"
        - "${ICP_HOSTNAME}"

---
# VirtualService: MI — routes HTTP to MI HTTPS service port.
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  name: mi-vs
  namespace: ${NAMESPACE}
spec:
  gateways:
    - ${NAMESPACE}/${ISTIO_GATEWAY_NAME}
  hosts:
    - "${MI_HOSTNAME}"
  http:
    - name: mi
      headers:
        request:
          set:
            x-forwarded-proto: https
      route:
        - destination:
            host: ${CLOUD_NAME}-${MI_RELEASE_NAME}
            port:
              number: ${MI_HTTPS_PORT}

---
# DestinationRule: MI — originate SIMPLE TLS toward the MI pod.
# exportTo restricts this rule to istio-system (ingress gateway only).
apiVersion: networking.istio.io/v1
kind: DestinationRule
metadata:
  name: mi-dr
  namespace: ${NAMESPACE}
spec:
  exportTo:
    - "istio-system"
  host: ${CLOUD_NAME}-${MI_RELEASE_NAME}
  trafficPolicy:
    tls:
      mode: SIMPLE
      insecureSkipVerify: true

---
# VirtualService: ICP — routes HTTP to ICP dashboard HTTPS service port.
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  name: icp-vs
  namespace: ${NAMESPACE}
spec:
  gateways:
    - ${NAMESPACE}/${ISTIO_GATEWAY_NAME}
  hosts:
    - "${ICP_HOSTNAME}"
  http:
    - name: icp
      headers:
        request:
          set:
            x-forwarded-proto: https
      route:
        - destination:
            host: ${CLOUD_NAME}-${ICP_RELEASE_NAME}
            port:
              number: ${ICP_HTTPS_PORT}

---
# DestinationRule: ICP — originate SIMPLE TLS toward the ICP pod.
# exportTo restricts this rule to istio-system (ingress gateway only).
apiVersion: networking.istio.io/v1
kind: DestinationRule
metadata:
  name: icp-dr
  namespace: ${NAMESPACE}
spec:
  exportTo:
    - "istio-system"
  host: ${CLOUD_NAME}-${ICP_RELEASE_NAME}
  trafficPolicy:
    tls:
      mode: SIMPLE
      insecureSkipVerify: true
