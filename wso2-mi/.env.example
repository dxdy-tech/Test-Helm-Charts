# Kubernetes and namespace
KUBECONFIG=/home/chamath/Downloads/openg2p-dad.yaml
NAMESPACE=wso2-mi
INGRESS_CLASS=nginx
TLS_SECRET_NAME=

# WSO2 MI chart and release names
HELM_MI_CHART_REPO=https://github.com/wso2/helm-mi.git
HELM_MI_CHART_REF=4.5.x
MI_RELEASE_NAME=wso2-mi
ICP_RELEASE_NAME=wso2-icp
CLOUD_NAME=openg2p

# Public hostnames
MI_HOSTNAME=mi.example.local
ICP_HOSTNAME=icp.example.local

# Istio VirtualService settings
# ISTIO_TLS_MODE: PASSTHROUGH (MI/ICP terminate TLS using JKS) or SIMPLE (edge termination)
# ISTIO_TLS_CREDENTIAL: credentialName of the TLS secret in istio-system (used only when mode=SIMPLE)
ISTIO_GATEWAY_NAME=mi-istio-gateway
ICP_ISTIO_GATEWAY_NAME=mi-icp-istio-gateway
ISTIO_TLS_MODE=PASSTHROUGH
ISTIO_TLS_CREDENTIAL=
# MI pass-through HTTPS port: 8243 + MI_PORT_OFFSET - 10
MI_HTTPS_PORT=8253
# ICP dashboard HTTPS port
ICP_HTTPS_PORT=9743

# Routing mode
ENABLE_INGRESS=true
ENABLE_GATEWAY_API=false

# Gateway API settings (used when ENABLE_GATEWAY_API=true)
GATEWAY_CREATE=true
GATEWAY_CLASS_NAME=envoy
GATEWAY_NAME=envoy
GATEWAY_NAMESPACE=envoy-gateway
GATEWAY_TLS_SECRET=
GATEWAY_BACKEND_TLS_ENABLED=false
GATEWAY_BACKEND_TLS_HOSTNAME=localhost
GATEWAY_RATE_LIMIT_ENABLED=false
GATEWAY_RATE_LIMIT_RPS=100
GATEWAY_RATE_LIMIT_BURST=50

# Runtime settings
MI_PORT_OFFSET=10
MI_ADMIN_USERNAME=admin
MI_ADMIN_PASSWORD=admin

# Keystore/truststore secret
KEYSTORE_SECRET_NAME=mi-jks-secret
AUTO_GENERATE_KEYSTORES=true
KEYSTORE_PASSWORD=wso2carbon
KEYSTORE_KEY_PASSWORD=wso2carbon
KEYSTORE_DNAME=CN=mi.example.local,OU=Platform,O=OpenG2P,L=Colombo,ST=Western,C=LK

# Source image
IMAGE_REGISTRY=docker.wso2.com
MI_IMAGE_REPOSITORY=wso2mi
IMAGE_PULL_SECRET_USERNAME=REPLACE_WITH_WSO2_USERNAME
IMAGE_PULL_SECRET_PASSWORD=REPLACE_WITH_WSO2_PASSWORD

# Custom registry where built image is pushed
CUSTOM_IMAGE_REGISTRY=docker.io
MI_CUSTOM_IMAGE_REPOSITORY=vsoneworld/openg2pdad-wso2-mi
CUSTOM_IMAGE_PULL_SECRET_USERNAME=REPLACE_WITH_REGISTRY_USERNAME
CUSTOM_IMAGE_PULL_SECRET_PASSWORD=REPLACE_WITH_REGISTRY_PASSWORD
IMAGE_PULL_SECRET_NAME=mi-image-registry-auth
SKIP_IMAGE_BUILD=false

MI_IMAGE_TAG=4.6.0
MI_IMAGE_PULL_POLICY=Always
MI_BUILD_VERSION=4.6.0

# ICP image
WSO2_IMAGE_PULL_SECRET_NAME=wso2-image-registry-auth
ICP_IMAGE_REGISTRY=docker.wso2.com
ICP_IMAGE_REPOSITORY=wso2-integration-control-plane
ICP_IMAGE_TAG=1.2.0.7-alpine
ICP_IMAGE_PULL_POLICY=IfNotPresent
ICP_BUILD_VERSION=1.2.0

# MI replica settings
MI_REPLICAS=2
MI_HPA_ENABLED=false
MI_MIN_REPLICAS=2
MI_MAX_REPLICAS=4
MI_HPA_CPU_PERCENT=75
MI_HPA_MEMORY_PERCENT=75

# MI resource profile
MI_CPU_REQUEST=500m
MI_MEMORY_REQUEST=512Mi
MI_CPU_LIMIT=1000m
MI_MEMORY_LIMIT=1Gi
MI_JVM_XMS=512m
MI_JVM_XMX=1024m

# ICP replica and resource settings
ICP_REPLICAS=1
ICP_CPU_REQUEST=500m
ICP_MEMORY_REQUEST=512Mi
ICP_CPU_LIMIT=1000m
ICP_MEMORY_LIMIT=1Gi
ICP_JVM_XMS=512m
ICP_JVM_XMX=1024m

# Helm behavior
HELM_TIMEOUT=20m
HELM_WAIT=true
HELM_ATOMIC=true

# Undeploy behavior
DELETE_NAMESPACE=false
