##
## Sample Dockerfile for the DAD Farmer Registry custom Social Registry image.
## This image extends Odoo 17 with OpenG2P Social Registry addons.
##
## Build:
##   docker build -t registry.example.com/dad-farmer-registry:1.0.0 \
##     -f Dockerfile.social-registry .
##
## The image must include all modules listed in
## socialRegistry.odoo.modules in your Helm values.
##

FROM odoo:17

USER root

# Install build dependencies needed by some OpenG2P Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    libldap2-dev \
    libsasl2-dev \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# OpenG2P core addons
# ---------------------------------------------------------------------------
# Option A: Copy pre-cloned addon directories
COPY ./addons/g2p_agent_portal_base         /mnt/extra-addons/g2p_agent_portal_base
COPY ./addons/g2p_registry_individual       /mnt/extra-addons/g2p_registry_individual
COPY ./addons/g2p_registry_group            /mnt/extra-addons/g2p_registry_group
COPY ./addons/g2p_registry_membership       /mnt/extra-addons/g2p_registry_membership
COPY ./addons/g2p_registry_dashboard        /mnt/extra-addons/g2p_registry_dashboard
COPY ./addons/g2p_registry_theme            /mnt/extra-addons/g2p_registry_theme
COPY ./addons/g2p_odk_importer              /mnt/extra-addons/g2p_odk_importer
COPY ./addons/g2p_registry_rest_api         /mnt/extra-addons/g2p_registry_rest_api
COPY ./addons/g2p_registry_deduplication_deduplicator /mnt/extra-addons/g2p_registry_deduplication_deduplicator
COPY ./addons/g2p_registration_portal_base  /mnt/extra-addons/g2p_registration_portal_base
COPY ./addons/g2p_odk_user_mapping          /mnt/extra-addons/g2p_odk_user_mapping

# Option B: Alternatively, clone from Git at build time (pin to a tag/commit):
# RUN git clone --depth 1 --branch v1.5.7 \
#     https://github.com/OpenG2P/openg2p-registry.git /tmp/openg2p-registry \
#     && cp -r /tmp/openg2p-registry/g2p_* /mnt/extra-addons/ \
#     && rm -rf /tmp/openg2p-registry

# ---------------------------------------------------------------------------
# DAD custom addons (uncomment when ready)
# ---------------------------------------------------------------------------
# COPY ./addons/dad_farmer_registry  /mnt/extra-addons/dad_farmer_registry
# COPY ./addons/dad_rest_api         /mnt/extra-addons/dad_rest_api

# ---------------------------------------------------------------------------
# Install Python dependencies required by addons
# ---------------------------------------------------------------------------
COPY ./requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt

# Fix permissions
RUN chown -R odoo:odoo /mnt/extra-addons

USER odoo

# Set the addons path to include the extra addons directory
ENV ODOO_EXTRA_ADDONS=/mnt/extra-addons
