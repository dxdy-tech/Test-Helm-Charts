##
## Custom Social Registry image for DAD Farmer Registry.
##
## Patches the upstream OpenG2P image so that:
##   1. The bootstrap odoo.conf includes OpenG2P extra-addon directories in
##      addons_path from the start (the base image delays this to
##      post-init-openg2p.sh which runs AFTER bootstrap).
##   2. First-run --init honours the ODOO_INIT_MODULES env var instead of the
##      hardcoded "all", allowing the Helm chart to install exactly the modules
##      it needs in a single pass.
##
## Build:
##   docker build -t vsoneworld/openg2pdad:0.0.1 \
##     -f Dockerfile.social-registry .
##

ARG BASE_IMAGE=openg2p/openg2p-social-registry-core:1.5.7
FROM ${BASE_IMAGE}

USER root

# ---------------------------------------------------------------------------
# 1. Patch the odoo.conf template so the bootstrap-generated config already
#    includes the extra-addon directories.  Without this, --init only sees
#    the 578 built-in Odoo modules (addons_path = /opt/bitnami/odoo/addons).
# ---------------------------------------------------------------------------
RUN sed -i \
    's|^addons_path = {{ODOO_ADDONS_DIR}}$|addons_path = {{ODOO_ADDONS_DIR}},/opt/bitnami/odoo/extraaddons/oca,/opt/bitnami/odoo/extraaddons/openg2p-registry,/opt/bitnami/odoo/extraaddons/openg2p-social-registry|' \
    /opt/bitnami/scripts/odoo/bitnami-templates/odoo.conf.tpl

# ---------------------------------------------------------------------------
# 2. Patch libodoo.sh: replace the hardcoded --init=all with a configurable
#    ODOO_INIT_MODULES env var.  When set, only the listed modules (+ their
#    dependencies) are installed during first-run bootstrap.
# ---------------------------------------------------------------------------
RUN sed -i \
    's|local -a init_args=("--init=all")|local -a init_args=("--init=${ODOO_INIT_MODULES:-all}")|' \
    /opt/bitnami/scripts/libodoo.sh

# ---------------------------------------------------------------------------
# 3. Patch libodoo.sh: auto-detect an already-bootstrapped external database.
#    When the PVC is recreated but the external DB retains modules (e.g. RDS
#    surviving a Helm chart reinstall), the Bitnami init marker is lost and
#    bootstrap re-runs --init, causing data conflicts.  This patch queries
#    the DB for the ir_module_module table and auto-enables skip-bootstrap
#    mode when it already exists.
# ---------------------------------------------------------------------------
COPY patches/detect-existing-db.py /tmp/detect-existing-db.py
RUN python3 /tmp/detect-existing-db.py && rm /tmp/detect-existing-db.py

# ---------------------------------------------------------------------------
# 4. Fix upstream bug: g2p_documents/preview_document.js does not export the
#    G2PDocumentPreview class, causing g2p_document_encryption to fail with
#    "Widgetpreview is undefined".  Add the missing export and rename import.
#    Fixed upstream in https://github.com/OpenG2P/openg2p-registry/pull/288
#    but not included in base image 1.5.7.
# ---------------------------------------------------------------------------
RUN sed -i \
    's|^class G2PDocumentPreview|export class Widgetpreview|' \
    /opt/bitnami/odoo/extraaddons/openg2p-registry/g2p_documents/static/src/js/preview_document.js && \
    sed -i \
    's|G2PDocumentPreview\.template|Widgetpreview.template|; s|component: G2PDocumentPreview|component: Widgetpreview|' \
    /opt/bitnami/odoo/extraaddons/openg2p-registry/g2p_documents/static/src/js/preview_document.js

# ---------------------------------------------------------------------------
# (Optional) Layer DAD-specific addons on top of the base image.
# Uncomment and adapt when this repo ships addon source under ./addons/.
# ---------------------------------------------------------------------------
# COPY ./addons/dad_farmer_registry /opt/bitnami/odoo/extraaddons/dad/dad_farmer_registry
# COPY ./requirements.txt /tmp/requirements.txt
# RUN pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt

USER odoo
